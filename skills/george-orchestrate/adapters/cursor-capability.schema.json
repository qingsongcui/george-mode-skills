{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "george.cursor.capability/1",
  "title": "George Cursor capability snapshot",
  "description": "Session-bound probe output. Skill tree keeps this shape only. Catalogs stay empty here; fill models/types only in a task-dir snapshot for the current session.",
  "type": "object",
  "required": ["schema", "probed_at", "session_bound", "reuse", "tool", "models", "types", "absent", "quota", "isolation"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "george.cursor.capability/1" },
    "probed_at": { "type": "string" },
    "session_bound": { "const": true },
    "reuse": { "const": "forbid-across-sessions" },
    "tool": {
      "type": "object",
      "required": ["namespace", "name", "required", "optional"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "name": { "type": "string" },
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "models": {
      "type": "array",
      "description": "Empty in the skill schema file. Session snapshots copy the live whitelist.",
      "items": { "type": "string" },
      "default": []
    },
    "types": {
      "type": "array",
      "description": "Empty in the skill schema file. Session snapshots copy live subagent_type entries.",
      "items": {
        "type": "object",
        "required": ["name", "writes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "writes": { "enum": ["yes", "no", "unknown"] },
          "user_gated": { "type": "boolean" }
        }
      },
      "default": []
    },
    "absent": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names that must not be treated as callable Cursor APIs this session."
    },
    "quota": {
      "type": "object",
      "required": ["status", "probe"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["unknown", "rate-limit-seen"] },
        "probe": { "enum": ["unsupported", "error-text"] }
      }
    },
    "isolation": {
      "type": "object",
      "required": ["local", "cloud"],
      "additionalProperties": false,
      "properties": {
        "local": { "const": "shared-workspace" },
        "cloud": { "const": "user-requested-only" }
      }
    }
  }
}
